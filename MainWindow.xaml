<Window x:Class="MonitorHardware.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MonitorHardware"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="350">
    <Grid>
        <!-- <Button Name="button" Click="button_Click">Click Me!</Button> -->
        <TreeView ItemsSource="{Binding Hardware}"
            Name="HardwareSensorTreeView"
            SelectedItemChanged="ArbolSensores_SelectedItemChanged">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <!-- <TextBlock Text="{Binding HardwareName}" /> -->
                        <CheckBox Name="checkBox" IsChecked="{Binding IsChecked, Mode=TwoWay}" Content="{Binding HardwareName}" />
                    </StackPanel>
                    <!-- <TextBlock Text="{Binding HardwareName}"/> -->
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </Grid>
</Window>
