<Window x:Class="MonitorHardware.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MonitorHardware"
        mc:Ignorable="d"
        Title="MonitorHardware"
        Height="550"
        Width="500"
        MinHeight="400"
        MinWidth="400"
        Background="#F3F4F6">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- NAVBAR SUPERIOR -->
        <Border Grid.Row="0"
                Background="#20252D"
                Padding="12">

            <DockPanel LastChildFill="True">

                <TextBlock Text="MonitorHardware"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"
                           DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Guardar"
                            Click="button_Click"
                            Padding="10,6"
                            Margin="3,0"
                            Background="#3478C8"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <Button Content="Abrir widget"
                            Click="OpenWidget_Click"
                            Padding="10,6"
                            Margin="3,0"
                            Background="#3478C8"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <Button Content="Cerrar widget"
                            Click="CloseWidget"
                            Padding="10,6"
                            Margin="3,0"
                            Background="#424954"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ÁRBOL DE SENSORES -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D9DDE3"
                BorderThickness="1"
                CornerRadius="6"
                Margin="10"
                Padding="8">

            <DockPanel>
                <TextBlock Text="Sensores disponibles"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="4,4,4,10"
                           DockPanel.Dock="Top"/>

                <TreeView Name="HardwareSensorTreeView"
                          BorderThickness="0"
                          Background="White">

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate
                            ItemsSource="{Binding Children}">

                            <CheckBox
                                IsChecked="{Binding IsChecked,
                                                    Mode=TwoWay}"
                                Content="{Binding HardwareName}"
                                Click="SensorCheckBox_Click"
                                Padding="2"
                                Margin="0,2"/>

                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded"
                                    Value="True"/>
                            <Setter Property="Padding"
                                    Value="2"/>
                        </Style>
                    </TreeView.ItemContainerStyle>

                </TreeView>
            </DockPanel>
        </Border>

        <!-- BARRA INFERIOR -->
        <!-- <Border Grid.Row="2"
                Background="#E5E7EB"
                Padding="10">

            <DockPanel LastChildFill="True">

                <Button Content="SELECT"
                        Click="button_Click"
                        Padding="15,7"
                        Margin="0,0,10,0"
                        DockPanel.Dock="Right"/>

                <TextBlock Name="SelectedSensorTextBlock"
                           Text="Seleccioná un sensor"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

            </DockPanel>
        </Border> -->

    </Grid>
</Window>
